# Pinned inputs of the stand. `setup.sh` verifies every download against these hashes.
XRAY_VERSION=v26.11.9
XRAY_ZIP=Xray-linux-64.zip
XRAY_URL=https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/${XRAY_ZIP}
XRAY_SHA256=b651f7e1d9966ee2c1b1ee1bf8b52c72771824d3065dce96bbc8bcc19ed95f82

SINGBOX_VERSION=1.14.4
SINGBOX_TGZ=sing-box-${SINGBOX_VERSION}-linux-amd64.tar.gz
SINGBOX_URL=https://github.com/SagerNet/sing-box/releases/download/v${SINGBOX_VERSION}/${SINGBOX_TGZ}
SINGBOX_SHA256=699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968

# Unbihex release binaries (no source build by default). The test_server asset
# has its own version, independent of the release tag.
UNBIHEX_VERSION=v0.2.10
UNBIHEX_CLI_TGZ=unbihex-cli-0.2.10-linux-x86_64.tar.gz
UNBIHEX_CLI_URL=https://github.com/crystalmasta/unbihex/releases/download/${UNBIHEX_VERSION}/${UNBIHEX_CLI_TGZ}
UNBIHEX_CLI_SHA256=ba208e1cef68bc1e5f0854e2e243af7c543ad4658b81f10f32f7ca98b9b290e4

UNBIHEX_SERVER_ASSET_VERSION=0.0.3
UNBIHEX_SERVER_TGZ=test_server-0.0.3-linux-x86_64.tar.gz
UNBIHEX_SERVER_URL=https://github.com/crystalmasta/unbihex/releases/download/${UNBIHEX_VERSION}/${UNBIHEX_SERVER_TGZ}
UNBIHEX_SERVER_SHA256=64e1617b59c1d706013677f678ea172d4d44ac8d599d2e2a02a4786b05ed1fb1

# Ports. One server per protocol+implementation so scenarios never share a port.
DEST_PORT=18446
XRAY_REALITY_PORT=18443
XRAY_XHTTP_PORT=18444
SINGBOX_REALITY_PORT=18453
UNBIHEX_REALITY_PORT=18463
UNBIHEX_RELEASE_REALITY_PORT=18473
XRAY_SOCKS=10808
SINGBOX_SOCKS=10818
SINK_IP=203.0.113.7
SINK_PORT=19000

# Fixed test credentials: a stand that changes its UUID/keys between runs is not comparable.
UUID=b831381d-6324-4d53-ad4f-8cda48b30811
SHORT_ID=

# SNI used by REALITY and by the TLS "dest" site (must match the certificate).
SNI=localhost
