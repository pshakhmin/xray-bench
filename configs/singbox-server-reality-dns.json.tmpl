{
  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [ @DNS_SERVERS@ ],
    "final": "@DNS_FIRST@"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "127.0.0.1",
      "listen_port": @PORT@,
      "users": [{ "uuid": "@UUID@", "flow": "" }],
      "tls": {
        "enabled": true,
        "server_name": "@SNI@",
        "reality": {
          "enabled": true,
          "handshake": { "server": "127.0.0.1", "server_port": @DEST_PORT@ },
          "private_key": "@PRIVATE_KEY@",
          "short_id": ["@SHORT_ID@"]
        }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct", "domain_resolver": "@DNS_FIRST@" }
  ]
}
