{
  "log": { "level": "warning" },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality",
      "listen": "127.0.0.1:@PORT@",
      "users": [{ "id": "@UUID@", "email": "bench" }],
      "reality": {
        "dest": "127.0.0.1:@DEST_PORT@",
        "server_names": ["@SNI@"],
        "private_key": "@PRIVATE_KEY@",
        "short_ids": ["@SHORT_ID@"]
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": { "final": "direct" }
}
